# Copy to .env for `vercel dev` (or paste into Vercel → Settings → Environment Variables).
# Several Gemini keys, oldest/fastest first — the function rotates on 429.
GEMINI_API_KEYS=AIzaSyKeyNumberOne,AIzaSyKeyNumberTwo,AIzaSyKeyNumberThree

# Optional
GEMINI_MODEL=gemini-2.5-flash-lite
# ALLOWED_ORIGIN=*
